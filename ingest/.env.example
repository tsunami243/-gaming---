# 采集管线配置模板 —— 复制为 .env 后填写真实值。
# .env 已被 .gitignore 排除，切勿把填好真实值的文件提交到仓库。
#
#   cp .env.example .env
#
# 安全提醒：
#   1) 本文件只写占位值；真实 Key 一旦落进 .env，就等于以明文常驻工作目录——
#      打包外发、录屏、误提交都会直接泄露。生产/CI 请改用进程级或容器 secret 注入，
#      本地临时跑则建议直接 export，不落盘：
#        $env:DEEPSEEK_API_KEY="..."        # PowerShell
#        export DEEPSEEK_API_KEY=...        # bash
#   2) 若某个 Key 曾经写进仓库、截图或分享过，一律视为已泄露并立即轮换：
#      DeepSeek Key 在控制台重置；OSS AccessKey 到 RAM 控制台禁用旧 Key 再建新的。

# ---------------------------------------------------------------------------
# 入库投递（必填：不配置则无法把采集结果送到后端）
# ---------------------------------------------------------------------------
# 后端地址；本地开发为 http://127.0.0.1:8080
INGEST_INTERNAL_BASE_URL=http://127.0.0.1:8080
# 必须与后端 application.yml 的 ingest.service-token（即 INGEST_SERVICE_TOKEN 环境变量）一致
INGEST_SERVICE_TOKEN=replace-with-long-random-token

# ---------------------------------------------------------------------------
# Redis（URL 去重与统计；不可用时管线自动降级，不阻断采集）
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------------------------------------------------------------------------
# DeepSeek（仅在未加 --no-ai 时使用；留空则必须显式传 --no-ai）
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ---------------------------------------------------------------------------
# 阿里云 OSS（当前采集链路不使用：首期不采集图片，main.py 中 oss 为 None）
# ---------------------------------------------------------------------------
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ARTICLE_DIR=articles

# ---------------------------------------------------------------------------
# 抓取节流与预算（默认值即安全值，通常无需修改）
# ---------------------------------------------------------------------------
CRAWL_DELAY_SECONDS=3
MAX_ARTICLES_PER_RUN=10
MAX_CANDIDATES_PER_DAY=80

# ---------------------------------------------------------------------------
# 运行时状态与容量闸门
# ---------------------------------------------------------------------------
RUNTIME_STATE_PATH=runtime/ingest_state.sqlite3
OUTBOX_PATH=runtime/outbox.sqlite3
MAX_OUTBOX_PENDING=200
MAX_RUNTIME_STORAGE_BYTES=50000000
# 磁盘容量快照路径；留空则采购容量闸门按 fail-closed 拒绝新采集
CAPACITY_SNAPSHOT_PATH=
DISK_WARN_BYTES=7000000000
DISK_STOP_BYTES=8000000000
DISK_HARD_BYTES=10000000000
