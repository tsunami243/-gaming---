<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.bigevent.mapper.ArticleMapper">
    <!--动态sql查询文章列表-->
    <select id="list" resultType="org.example.bigevent.pojo.Article">
        select * from article
        <where>
            <if test="categoryId!=null">
                and category_id=#{categoryId}
            </if>
            <if test="state!=null">
                and state=#{state}
            </if>
            <if test="userId!=null">
                and create_user=#{userId}
            </if>
        </where>
    </select>

    <!--根据标签查询文章列表-->
    <select id="searchByTag" resultType="org.example.bigevent.pojo.Article">
        select * from article
        <where>
            and JSON_CONTAINS(tags, CONCAT('"', #{tag}, '"'))
        </where>
    </select>
</mapper>


