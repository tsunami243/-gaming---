# Copy to .env only on the isolated host; never commit secrets.
#   docker compose --env-file deploy/.env -f deploy/compose.yaml up -d
#
# 这里只放占位值。填过真实值的 .env 一律不得提交（已被 .gitignore / .dockerignore 排除）。

# ---- 数据库（同时供 mysql 容器与 backend 读取）----
DB_USERNAME=gameboi
DB_PASSWORD=replace-before-use
MYSQL_ROOT_PASSWORD=replace-before-use

# ---- 应用密钥 ----
JWT_SECRET_KEY=replace-with-long-random-secret
INGEST_SERVICE_TOKEN=replace-with-long-random-token

# ---- Redis（未设密码留空）----
REDIS_PASSWORD=

# ---- 采集端第三方凭据（仅在启用 AI 清洗 / OSS 存图时才需要）----
DEEPSEEK_API_KEY=replace-before-use
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=replace-before-use
OSS_ACCESS_KEY_SECRET=replace-before-use
OSS_BUCKET_NAME=replace-before-use

# ---- 对外端口 ----
GAMEBOI_HTTP_PORT=8088
